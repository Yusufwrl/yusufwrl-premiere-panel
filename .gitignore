# Kurulum cikti/gecici dosyalari
installer/dist/
installer/staging/
installer/panel.zip
installer/YusufwrlKur.exe

# Makineye ozel — YALNIZ PANEL KOKUNDE (bastaki / bunu saglar).
# Bastaki / OLMADAN kural her klasorde gecerli olur ve varsayilan\presetler.json (pakete
# GIREN hazir preset dosyasi) sessizce yok sayilir; arkadasin panelinde preset'ler bos gelir.
/engine-root.txt
/diarize-device.txt
/sozluk.json
/assemblyai-key.txt
/anthropic-key.txt
/kisiler.json
/presetler.json
/presetler.bak.json
# Atomik yazmanin ara dosyalari (js/app.js presetYiginlarYaz). Normalde saniyeler icinde
# yok olurlar; yazma yarida kalirsa diskte kalir ve kurtarma kaynagi OLURLAR.
/presetler.json.tmp
/presetler.bak.json.yeni
# lisans.json = bu makinenin lisansi (sifre BIR KEZ girilsin diye). Repoya girmemeli:
# icinde HWID karmasi var ve her makinede farkli.
/lisans.json
/lisans.json.bak

# Motor ASLA repoya girmez (~3 GB)
engine/
YusufwrlEngine/

# Genel
node_modules/
*.log
Thumbs.db
desktop.ini

# Cloudflare wrangler onbellegi — HESAP BILGISI iceriyor (wrangler-account.json),
# repoya girmemeli. Secret'lar zaten Cloudflare'de duruyor, dosyada degil.
sunucu/.wrangler/
sunucu/node_modules/
