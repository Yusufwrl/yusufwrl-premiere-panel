# Kurulum cikti/gecici dosyalari
installer/dist/
installer/staging/
installer/panel.zip
installer/YusufwrlKur.exe
# ⚠ KOKTEKI panel.zip DE ELENMELI. Eskiden yalniz installer/panel.zip yaziyordu; kokte
# argumansiz/yanlis yollu bir pack-panel cagrisindan kalma 16,7 MB'lik bir panel.zip
# GIT'E IZLENIYORDU ve icinde v1.9.9 vardi (62 dosya, ilerleme.js yok — dort surum eski).
# Repo public: depoya bakan biri onu "dagitim paketi" sanip indirebilir, ya da acele bir
# anda ikinci kullaniciya gonderilebilirdi. Bayat staging\panel ile AYNI SINIF tuzak:
# dogru gorunen ad, yanlis icerik. Dagitilan tek zip installer\panel.zip'tir.
/panel.zip

# Makineye ozel — YALNIZ PANEL KOKUNDE (bastaki / bunu saglar).
# Bastaki / OLMADAN kural her klasorde gecerli olur ve varsayilan\presetler.json (pakete
# GIREN hazir preset dosyasi) sessizce yok sayilir; arkadasin panelinde preset'ler bos gelir.
/engine-root.txt
/diarize-device.txt
/sozluk.json
/assemblyai-key.txt
/anthropic-key.txt
/kisiler.json
/presetler.json
/presetler.bak.json
# lisans.json = bu makinenin lisansi (sifre BIR KEZ girilsin diye). Repoya girmemeli:
# icinde HWID karmasi var ve her makinede farkli.
/lisans.json
/lisans.json.bak

# Motor ASLA repoya girmez (~3 GB)
engine/
YusufwrlEngine/

